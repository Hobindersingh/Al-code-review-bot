# =====================================================================
#  AI Code Review Bot configuration. Copy to `.env` and fill in the values.
#  Write values as KEY=value (no spaces around "=", no quotes).
# =====================================================================

# ---- 1. Required: webhook secret (any long random string, 20+ chars) ----
# Make one:  openssl rand -hex 24
# Use the SAME value in your GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# ---- 2. Required: free Google Gemini key ----
# Get it free (no card): https://aistudio.google.com/apikey  -> "Create API key"
# NOTE: on the free tier Google may use your prompts to improve its products.
#       Only review public/non-confidential code with the free tier.
LLM_PROVIDER=gemini
LLM_API_KEY=
# Model: leave empty for the default (gemini-3.8-flash). To change it, copy a current
# Flash / Flash-Lite model name from AI Studio, e.g. a "flash-lite" model for higher free limits.
LLM_MODEL=
# Max model requests per minute from this worker (free tier is low). 0 = unlimited.
LLM_MAX_RPM=8

# ---- 3. Required: GitHub access (token OR GitHub App) ----
# fine-grained PAT: Pull requests RW, Contents R, Metadata R
GITHUB_TOKEN=
GITHUB_APP_ID=
# PEM contents; newlines may be written as \n
GITHUB_APP_PRIVATE_KEY=

# ---- 4. Safety switch: keep true for your first run ----
# true = analyse PRs and show results in the dashboard, but post NOTHING to GitHub
DRY_RUN=true

# ---- Infra (the defaults work with docker compose) ----
MONGO_URI=mongodb://localhost:27017/ai-code-review
REDIS_URL=redis://localhost:6379
PORT=4000
CORS_ORIGIN=http://localhost:5173
# >=16 chars. Leave empty only for local development
DASHBOARD_API_KEY=
# set to 1 behind one reverse proxy
TRUST_PROXY=0
LOG_LEVEL=info

# ---- Agent behaviour (tuned for free-tier limits) ----
AGENT_MAX_ITERATIONS=6
AGENT_MAX_TOOL_CALLS=6
AGENT_TOKEN_BUDGET=120000
MAX_FILES=40
MAX_DIFF_CHARS=60000
MIN_CONFIDENCE=0.6
MIN_SEVERITY=low
MAX_INLINE_COMMENTS=12
POST_WHEN_CLEAN=true

# ---- Worker (one job at a time keeps you inside free-tier rate limits) ----
WORKER_CONCURRENCY=1
WORKER_RATE_PER_MIN=6

# ---- Other providers (optional) ----
# OpenAI:   LLM_PROVIDER=openai  and  LLM_API_KEY=sk-...   (LLM_MODEL defaults to gpt-4o-mini; set LLM_MAX_RPM=0)
# Groq:     LLM_PROVIDER=custom  LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.3-70b-versatile
# Ollama:   LLM_PROVIDER=custom  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=<model>  LLM_API_KEY=ollama
